{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "deal-scout://contracts/creative-acquisition/2026.8.19",
  "title": "ContractVariables",
  "description": "Binding variables for user-supplied REVIEW_PENDING acquisition and assignment drafts. This schema does not establish legal approval.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "buyer_name": { "type": "string", "minLength": 1 },
    "seller_name": { "type": "string", "minLength": 1 },
    "assignor_name": { "type": "string", "minLength": 1 },
    "assignee_name": { "type": "string", "minLength": 1 },
    "primary_agreement_date": { "type": "string", "format": "date" },
    "inspection_expiration_date": { "type": "string", "format": "date" },
    "property_address": { "type": "string", "minLength": 1 },
    "legal_description": { "type": "string", "minLength": 1 },
    "purchase_price": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{2})$" },
    "inspection_days": { "type": "integer", "minimum": 1, "default": 10 },
    "access_notice_hours": { "type": "integer", "minimum": 1, "default": 24 },
    "due_on_sale_risk": { "type": "string", "enum": ["buyer", "seller"] },
    "due_on_sale_resolution_days": { "type": "integer", "minimum": 1, "default": 30 },
    "default_grace_days": { "type": "integer", "minimum": 1, "default": 15 },
    "cure_days": { "type": "integer", "minimum": 1, "default": 10 },
    "end_buyer_emd": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{2})$" },
    "assignment_fee": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{2})$" },
    "escrow_servicer_name": { "type": "string", "minLength": 1, "default": "To be mutually selected prior to closing" },
    "escrow_fee_allocation": { "type": "string", "enum": ["buyer", "seller", "split"] }
  },
  "required": [
    "buyer_name",
    "seller_name",
    "assignor_name",
    "assignee_name",
    "primary_agreement_date",
    "inspection_expiration_date",
    "property_address",
    "legal_description",
    "purchase_price",
    "inspection_days",
    "access_notice_hours",
    "due_on_sale_risk",
    "due_on_sale_resolution_days",
    "default_grace_days",
    "cure_days",
    "end_buyer_emd",
    "assignment_fee",
    "escrow_servicer_name",
    "escrow_fee_allocation"
  ]
}
