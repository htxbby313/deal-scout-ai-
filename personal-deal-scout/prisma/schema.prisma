generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemMode {
  RESEARCH
  ACTIVE
  PAUSED
}

enum QualificationStatus {
  RESEARCH_NEEDED
  LIMITED_CONTACT
  QUALIFIED
  PRIORITY
  REJECTED
}

enum OpportunityStatus {
  NEEDS_VERIFICATION
  DEVELOPMENT_SIGNAL
  CONFIRMED_AVAILABLE
  GOVERNMENT_SALE
  REJECTED
}

enum ResearchFindingStatus {
  VERIFIED
  NOT_FOUND
  CONFLICT
  NEEDS_MANUAL_VERIFICATION
}

enum PropertyMediaKind {
  LISTING_PHOTO
  MAP
  PARCEL
  DOCUMENT
  OTHER
}

model Property {
  id             String   @id @default(cuid())
  address        String
  city           String
  state          String
  zipCode        String
  ownerName      String
  county         String?
  neighborhood   String?
  latitude       Float?
  longitude      Float?
  marketFips     String?
  yearBuilt      String?
  lotSize        String?
  estimatedValue Int?
  notes          String?
  opportunityStatus OpportunityStatus @default(NEEDS_VERIFICATION)
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  contactUrl     String?
  sourceName     String?
  sourceUrl      String?
  sourceRecordDate String?
  verificationSourceUrl String?
  verificationDate String?
  lastVerifiedAt DateTime?
  confidence     Int @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  leads          Lead[]
  matches        DeveloperMatch[]
  researchRuns   PropertyResearchRun[]
  researchFindings PropertyResearchFinding[]
  media          PropertyMedia[]
  transactions   DealTransaction[]

  @@unique([address, zipCode])
  @@index([opportunityStatus])
  @@index([marketFips])
}

model PropertyResearchRun {
  id             String   @id @default(cuid())
  propertyId     String
  status         String
  sourcesChecked Int      @default(0)
  findingsFound  Int      @default(0)
  manualNeeded   Int      @default(0)
  error          String?
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, startedAt])
}

model PropertyResearchFinding {
  id          String                @id @default(cuid())
  propertyId  String
  topic       String
  label       String
  value       String?
  status      ResearchFindingStatus
  sourceName  String?
  sourceUrl   String?
  observedAt  DateTime              @default(now())
  confidence  Int                   @default(0)
  notes       String?
  property    Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, topic])
  @@index([propertyId, status])
}

model PropertyMedia {
  id            String            @id @default(cuid())
  propertyId    String
  url           String
  sourceUrl     String
  sourceName    String
  caption       String?
  altText       String
  kind          PropertyMediaKind @default(LISTING_PHOTO)
  position      Int               @default(0)
  sendApproved  Boolean           @default(false)
  discoveredAt  DateTime          @default(now())
  reviewedAt    DateTime?
  property      Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, url])
  @@index([propertyId, position])
}

model Lead {
  id                     String   @id @default(cuid())
  propertyId             String
  ownerName              String
  status                 String
  priority               String
  nextActionType         String
  nextActionAt           String
  estimatedAssignmentFee Int      @default(0)
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  property               Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tasks                  Task[]
  approvals              MessageApproval[]
  transactions           DealTransaction[]

  @@unique([propertyId])
}

model Task {
  id          String    @id @default(cuid())
  leadId      String
  title       String
  type        String
  priority    String
  status      String    @default("OPEN")
  dueAt       String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, title])
}

model Developer {
  id                    String   @id @default(cuid())
  companyName           String   @unique
  contactName           String?
  phone                 String?
  email                 String?
  website               String?
  contactUrl            String?
  targetZipCodes        String[]
  maximumPurchasePrice  Int?
  typicalBuildPrice     Int?
  notes                 String?
  active                Boolean  @default(true)
  qualificationStatus   QualificationStatus @default(RESEARCH_NEEDED)
  contactVerifiedAt     DateTime?
  lastResearchedAt      DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  projects              DeveloperProject[]
  matches               DeveloperMatch[]
  researchRuns          DeveloperResearchRun[]
  transactions          DealTransaction[]

  @@index([qualificationStatus])
}

enum DealTransactionStatus {
  DRAFT
  RESEARCH
  DUE_DILIGENCE
  OFFER_PENDING
  UNDER_CONTRACT
  BUYER_MATCHING
  ASSIGNMENT_PENDING
  CLOSING_PENDING
  COMPLETED
  CANCELLED
}

enum TransactionControlStatus {
  ACTIVE
  ON_HOLD
  STOPPED
}

enum TransactionApprovalType {
  SELLER_CONTACT
  BUYER_CONTACT
  OFFER
  CONTRACT
  ASSIGNMENT_MARKETING
  ASSIGNMENT
  EARNEST_MONEY
  CLOSING_INSTRUCTION
  PHOTO_REDISTRIBUTION
  OTHER
}

enum TransactionApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum TransactionDocumentStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  EXECUTED
  VOIDED
}

model DeveloperResearchRun {
  id             String    @id @default(cuid())
  developerId    String
  status         String
  sourcesChecked Int       @default(0)
  findingsFound  Int       @default(0)
  manualNeeded   Int       @default(0)
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  developer      Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@index([developerId, startedAt])
  @@index([status, startedAt])
}

model DeveloperProject {
  id                    String    @id @default(cuid())
  developerId           String
  address               String
  city                  String
  state                 String
  zipCode               String
  originalPurchasePrice Int?
  newBuildSalePrice     Int?
  lotSquareFeet         Int?
  notes                 String?
  sourceName            String?
  sourceUrl             String?
  sourceRecordDate      String?
  verifiedAt            DateTime?
  confidence            Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  developer             Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@unique([developerId, address, zipCode])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  type      String
  channel   String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, channel])
}

model MessageApproval {
  id             String   @id @default(cuid())
  leadId         String?
  templateId     String?
  channel        String
  recipientLabel String
  subject        String?
  body           String
  status         String   @default("PENDING")
  provider       String   @default("disabled")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lead           Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String   @id @default(cuid())
  type      String
  summary   String
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ProviderSetting {
  id         String   @id @default(cuid())
  provider   String   @unique
  enabled    Boolean  @default(false)
  configured Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

model SystemSetting {
  id               String     @id @default("singleton")
  mode             SystemMode @default(RESEARCH)
  migrationVersion Int        @default(1)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model DeveloperMatch {
  id          String    @id @default(cuid())
  propertyId  String
  developerId String
  score       Int
  reasons     String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@unique([propertyId, developerId])
}

model GovernmentResearchRun {
  id           String   @id @default(cuid())
  source       String
  status       String
  period       String?
  recordsFound Int      @default(0)
  error        String?
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model MarketSignal {
  id           String   @id @default(cuid())
  source       String
  fips         String
  stateFips    String
  countyFips   String
  countyName   String
  stateName    String
  period       String
  currentUnits Int
  priorUnits   Int?
  growthPct    Float?
  currentValue BigInt
  rank         Int
  sourceUrl    String
  capturedAt   DateTime @default(now())

  @@unique([source, fips, period])
  @@index([period, rank])
}

model DealTransaction {
  id                   String                   @id @default(cuid())
  propertyId           String
  leadId               String?
  developerId          String?
  status               DealTransactionStatus    @default(DRAFT)
  controlStatus        TransactionControlStatus @default(ON_HOLD)
  ownerHoldReason      String?
  ownerHoldAt          DateTime?
  ownerStoppedAt       DateTime?
  targetSellerPrice    Int?
  targetBuyerPrice     Int?
  targetAssignmentFee  Int?
  jurisdictionState    String
  counselApprovedAt    DateTime?
  complianceVerifiedAt DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  property             Property                 @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  lead                 Lead?                    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  developer            Developer?               @relation(fields: [developerId], references: [id], onDelete: SetNull)
  documents            TransactionDocument[]
  approvals            TransactionApproval[]
  auditEvents          TransactionAuditEvent[]

  @@index([status, controlStatus])
  @@index([propertyId, createdAt])
  @@index([developerId])
}

model TransactionDocument {
  id              String                    @id @default(cuid())
  transactionId   String
  type            String
  title           String
  status          TransactionDocumentStatus @default(DRAFT)
  version         Int                       @default(1)
  storageKey      String?
  sourceUrl       String?
  contentHash     String?
  counselApproved Boolean                   @default(false)
  executedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  transaction     DealTransaction           @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([transactionId, type, version])
  @@index([transactionId, status])
}

model TransactionApproval {
  id            String                    @id @default(cuid())
  transactionId String
  type          TransactionApprovalType
  status        TransactionApprovalStatus @default(PENDING)
  requestedBy   String
  decidedBy     String?
  reason        String?
  requestedAt   DateTime                  @default(now())
  decidedAt     DateTime?
  expiresAt     DateTime?
  transaction   DealTransaction           @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([transactionId, type, status])
}

model TransactionAuditEvent {
  id            String          @id @default(cuid())
  transactionId String
  sequence      Int
  type          String
  actor         String
  summary       String
  details       Json?
  occurredAt    DateTime        @default(now())
  transaction   DealTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([transactionId, sequence])
  @@index([transactionId, occurredAt])
}
