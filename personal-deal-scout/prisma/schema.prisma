generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemMode {
  RESEARCH
  ACTIVE
  PAUSED
}

enum QualificationStatus {
  RESEARCH_NEEDED
  LIMITED_CONTACT
  QUALIFIED
  PRIORITY
  REJECTED
}

enum OpportunityStatus {
  NEEDS_VERIFICATION
  DEVELOPMENT_SIGNAL
  CONFIRMED_AVAILABLE
  GOVERNMENT_SALE
  REJECTED
}

enum ResearchFindingStatus {
  VERIFIED
  NOT_FOUND
  CONFLICT
  NEEDS_MANUAL_VERIFICATION
}

enum PropertyMediaKind {
  LISTING_PHOTO
  MAP
  PARCEL
  DOCUMENT
  OTHER
}

enum AgentRole {
  OPERATIONS_COORDINATOR
  RESEARCH
  SELLER_ACQUISITION
  BUYER_DEVELOPER
  PROFIT_UNDERWRITING
  COMMUNICATIONS_DISPOSITION
  TRANSACTION_COMPLIANCE
}

enum AgentActionZone {
  GREEN
  YELLOW
  RED
}

enum AgentCostClass {
  FREE
  METERED
  FIXED_COST
  UNKNOWN_COST
}

enum AgentSchedulerStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum AgentCycleTrigger {
  CRON
  OWNER
  EVENT
  RECOVERY
}

enum AgentCapabilityMode {
  AUTOMATIC_INTERNAL
  APPROVAL_REQUIRED
  AUTONOMOUS_EXTERNAL
  BLOCKED
}

enum AgentStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum AgentAutonomyMode {
  LOCKED
  SUPERVISED
  APPROVED_AUTONOMOUS
}

enum AgentTaskStatus {
  QUEUED
  IN_PROGRESS
  WAITING_FOR_APPROVAL
  BLOCKED
  COMPLETED
  CANCELLED
  FAILED
}

enum AgentTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AgentRunStatus {
  RUNNING
  WAITING_FOR_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentEventType {
  TASK_CREATED
  TASK_STARTED
  TASK_UPDATED
  HANDOFF_REQUESTED
  HANDOFF_ACCEPTED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  RUN_COMPLETED
  RUN_FAILED
  TASK_COMPLETED
  TASK_CANCELLED
}

enum ExternalProviderStatus {
  DISABLED
  MOCK_ONLY
  READY
  ACTIVE
  PAUSED
  CIRCUIT_OPEN
}

enum MarketDatasetImportStatus {
  QUEUED
  RUNNING
  COMPLETED
  QUARANTINED
  FAILED
}

enum DiscoveryReferenceStatus {
  SUBMITTED
  MATCHED
  CREATED_PROPERTY
  NEEDS_REVIEW
  REJECTED
}

model Property {
  id             String   @id @default(cuid())
  address        String
  city           String
  state          String
  zipCode        String
  ownerName      String
  county         String?
  neighborhood   String?
  latitude       Float?
  longitude      Float?
  marketFips     String?
  yearBuilt      String?
  lotSize        String?
  estimatedValue Int?
  notes          String?
  propertyType   String?
  leadSource     String?
  opportunityStatus OpportunityStatus @default(NEEDS_VERIFICATION)
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  contactUrl     String?
  sourceName     String?
  sourceUrl      String?
  sourceRecordDate String?
  verificationSourceUrl String?
  verificationDate String?
  lastVerifiedAt DateTime?
  confidence     Int @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  leads          Lead[]
  matches        DeveloperMatch[]
  researchRuns   PropertyResearchRun[]
  researchFindings PropertyResearchFinding[]
  media          PropertyMedia[]
  transactions   DealTransaction[]
  agentTasks     AgentTask[]
  acquisitionFunnels AcquisitionFunnel[]
  countyRegistryId String?
  countyRegistry CountySourceRegistry? @relation(fields: [countyRegistryId], references: [id], onDelete: SetNull)
  countyObservations CountyFactObservation[]
  countyEntityMatches CountyEntityMatch[]
  discoveryReferences PropertyDiscoveryReference[]

  @@unique([address, zipCode])
  @@index([opportunityStatus])
  @@index([opportunityStatus, updatedAt])
  @@index([marketFips])
  @@index([countyRegistryId])
}

model PropertyResearchRun {
  id             String   @id @default(cuid())
  propertyId     String
  researchVersion Int     @default(1)
  status         String
  sourcesChecked Int      @default(0)
  findingsFound  Int      @default(0)
  manualNeeded   Int      @default(0)
  error          String?
  attemptCount   Int      @default(0)
  maxAttempts    Int      @default(3)
  exhausted      Boolean  @default(false)
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, startedAt])
  @@index([propertyId, researchVersion])
  @@index([propertyId, status])
  @@index([status, startedAt])
}

model PropertyResearchFinding {
  id          String                @id @default(cuid())
  propertyId  String
  topic       String
  label       String
  value       String?
  status      ResearchFindingStatus
  sourceName  String?
  sourceUrl   String?
  observedAt  DateTime              @default(now())
  confidence  Int                   @default(0)
  notes       String?
  property    Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, topic])
  @@index([propertyId, status])
}

model PropertyMedia {
  id            String            @id @default(cuid())
  propertyId    String
  url           String
  sourceUrl     String
  sourceName    String
  caption       String?
  altText       String
  kind          PropertyMediaKind @default(LISTING_PHOTO)
  position      Int               @default(0)
  sendApproved  Boolean           @default(false)
  discoveredAt  DateTime          @default(now())
  reviewedAt    DateTime?
  property      Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, url])
  @@index([propertyId, position])
}

model Lead {
  id                     String   @id @default(cuid())
  propertyId             String
  ownerName              String
  status                 String
  priority               String
  nextActionType         String
  nextActionAt           String
  estimatedAssignmentFee Int      @default(0)
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  property               Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tasks                  Task[]
  approvals              MessageApproval[]
  transactions           DealTransaction[]

  @@unique([propertyId])
  @@index([status, priority, updatedAt])
}

model Task {
  id          String    @id @default(cuid())
  leadId      String
  title       String
  type        String
  priority    String
  status      String    @default("OPEN")
  dueAt       String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, title])
}

model Developer {
  id                    String   @id @default(cuid())
  companyName           String   @unique
  contactName           String?
  phone                 String?
  email                 String?
  website               String?
  contactUrl            String?
  targetZipCodes        String[]
  maximumPurchasePrice  Int?
  typicalBuildPrice     Int?
  notes                 String?
  active                Boolean  @default(true)
  qualificationStatus   QualificationStatus @default(RESEARCH_NEEDED)
  contactVerifiedAt     DateTime?
  lastResearchedAt      DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  projects              DeveloperProject[]
  matches               DeveloperMatch[]
  researchRuns          DeveloperResearchRun[]
  transactions          DealTransaction[]
  agentTasks            AgentTask[]
  demandVersions        BuyerDemandVersion[]
  capacityEvidence      BuyerCapacityEvidence[]
  reliabilityEvidence   BuyerReliabilityEvidence[]
  countyEntityMatches   CountyEntityMatch[]
  buyerPriceEvidence    BuyerPropertyPriceEvidence[]
  buyerPerformanceIssues BuyerPerformanceIssue[]
  buyerPermissions      BuyerCommunicationPermission[]
  buyerReliabilityScores BuyerReliabilityScoreHistory[]

  @@index([qualificationStatus])
  @@index([active, updatedAt])
}

enum DealTransactionStatus {
  DRAFT
  RESEARCH
  DUE_DILIGENCE
  OFFER_PENDING
  UNDER_CONTRACT
  BUYER_MATCHING
  ASSIGNMENT_PENDING
  CLOSING_PENDING
  COMPLETED
  CANCELLED
}

enum TransactionControlStatus {
  ACTIVE
  ON_HOLD
  STOPPED
}

enum TransactionApprovalType {
  SELLER_CONTACT
  BUYER_CONTACT
  OFFER
  CONTRACT
  ASSIGNMENT_MARKETING
  ASSIGNMENT
  EARNEST_MONEY
  CLOSING_INSTRUCTION
  PHOTO_REDISTRIBUTION
  OTHER
}

enum TransactionApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum TransactionDocumentStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  EXECUTED
  VOIDED
}

model DeveloperResearchRun {
  id             String    @id @default(cuid())
  developerId    String
  researchVersion Int      @default(1)
  status         String
  sourcesChecked Int       @default(0)
  findingsFound  Int       @default(0)
  manualNeeded   Int       @default(0)
  error          String?
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(3)
  exhausted      Boolean   @default(false)
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  developer      Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@index([developerId, startedAt])
  @@index([developerId, researchVersion])
  @@index([developerId, status])
  @@index([status, startedAt])
}

model DeveloperProject {
  id                    String    @id @default(cuid())
  developerId           String
  address               String
  city                  String
  state                 String
  zipCode               String
  originalPurchasePrice Int?
  newBuildSalePrice     Int?
  lotSquareFeet         Int?
  notes                 String?
  sourceName            String?
  sourceUrl             String?
  sourceRecordDate      String?
  verifiedAt            DateTime?
  confidence            Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  developer             Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  countyRegistryId      String?
  countyRegistry        CountySourceRegistry? @relation(fields: [countyRegistryId], references: [id], onDelete: SetNull)
  countyObservations    CountyFactObservation[]
  countyEntityMatches   CountyEntityMatch[]

  @@unique([developerId, address, zipCode])
  @@index([countyRegistryId])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  type      String
  channel   String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, channel])
}

model MessageApproval {
  id             String   @id @default(cuid())
  leadId         String?
  templateId     String?
  channel        String
  recipientLabel String
  subject        String?
  body           String
  status         String   @default("PENDING")
  provider       String   @default("disabled")
  blockerCodes   String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lead           Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String   @id @default(cuid())
  type      String
  summary   String
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ProviderSetting {
  id         String   @id @default(cuid())
  provider   String   @unique
  enabled    Boolean  @default(false)
  configured Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

model ExternalProvider {
  id                  String                  @id @default(cuid())
  key                 String                  @unique
  displayName         String
  kind                String
  status              ExternalProviderStatus @default(DISABLED)
  liveRequestsEnabled Boolean                 @default(false)
  policy              Json
  timeoutMs           Int                     @default(15000)
  maxAttempts         Int                     @default(3)
  quotaLimit          Int?
  quotaWindow         String?
  nextEligibleAt      DateTime?
  circuitOpenUntil    DateTime?
  failureCount        Int                     @default(0)
  activatedAt         DateTime?
  activatedBy         String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  datasets            MarketDatasetDefinition[]
  checkpoints         ProviderJobCheckpoint[]

  @@index([status, nextEligibleAt])
  @@index([circuitOpenUntil])
}

model ProviderJobCheckpoint {
  id             String           @id @default(cuid())
  providerId     String
  workType       String
  cursor         String?
  state          Json?
  nextEligibleAt DateTime?
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastError      String?
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  provider       ExternalProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([providerId, workType])
  @@index([nextEligibleAt])
}

model MarketDatasetDefinition {
  id                   String           @id @default(cuid())
  providerId           String
  key                  String           @unique
  name                 String
  definition           String
  canonicalCatalogUrl  String
  directUrl            String
  geography            String
  propertyType         String
  frequency            String
  identifierColumns    String[]
  dateColumnPattern    String
  expectedContentType  String
  expectedMaximumBytes Int
  attributionNote      String
  fixtureHash          String
  reviewedBy           String
  reviewedAt           DateTime
  enabled              Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  provider             ExternalProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  imports              MarketDatasetImport[]
  observations         MarketObservation[]

  @@index([providerId, enabled])
}

model MarketDatasetImport {
  id                String                    @id @default(cuid())
  definitionId      String
  status            MarketDatasetImportStatus @default(QUEUED)
  contentHash       String?
  sourceUrl         String
  sourceEffectiveAt DateTime?
  retrievedAt       DateTime?
  rowCount          Int                       @default(0)
  schemaSnapshot    Json?
  errorCode         String?
  errorMessage      String?
  nextEligibleAt    DateTime?
  attemptCount      Int                       @default(0)
  createdAt         DateTime                  @default(now())
  finishedAt        DateTime?
  definition        MarketDatasetDefinition   @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  observations      MarketObservation[]

  @@unique([definitionId, contentHash])
  @@index([status, nextEligibleAt])
  @@index([definitionId, createdAt])
}

model MarketObservation {
  id             String                  @id @default(cuid())
  definitionId   String
  importId       String
  geographyType  String
  regionId       String
  regionName     String
  period         DateTime
  value          Decimal
  unit           String
  sourceRevision String
  createdAt      DateTime                @default(now())
  definition     MarketDatasetDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  import         MarketDatasetImport     @relation(fields: [importId], references: [id], onDelete: Restrict)

  @@unique([importId, regionId, period])
  @@index([definitionId, regionId, period])
}

model PropertyDiscoveryReference {
  id                   String                   @id @default(cuid())
  propertyId           String?
  providerKey          String
  originalUrl          String
  normalizedUrl        String                   @unique
  status               DiscoveryReferenceStatus @default(SUBMITTED)
  submittedBy          String
  submittedAt          DateTime                 @default(now())
  observedAddress      String?
  observedAskingPrice  Decimal?
  observedAvailability String?
  observationNotes     String?
  verificationStatus   String                   @default("USER_OBSERVED_UNVERIFIED")
  lastComparedAt       DateTime?
  conflictSummary      Json?
  property             Property?                @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([propertyId, submittedAt])
  @@index([providerKey, status, submittedAt])
}

model SystemSetting {
  id               String     @id @default("singleton")
  mode             SystemMode @default(RESEARCH)
  migrationVersion Int        @default(1)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model DeveloperMatch {
  id          String    @id @default(cuid())
  propertyId  String
  developerId String
  score       Int
  reasons     String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@unique([propertyId, developerId])
}

model GovernmentResearchRun {
  id           String   @id @default(cuid())
  source       String
  status       String
  period       String?
  recordsFound Int      @default(0)
  error        String?
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([source, period, status, finishedAt])
}

model MarketSignal {
  id           String   @id @default(cuid())
  source       String
  fips         String
  stateFips    String
  countyFips   String
  countyName   String
  stateName    String
  period       String
  currentUnits Int
  priorUnits   Int?
  growthPct    Float?
  currentValue BigInt
  rank         Int
  sourceUrl    String
  capturedAt   DateTime @default(now())

  @@unique([source, fips, period])
  @@index([period, rank])
}

model DealTransaction {
  id                   String                   @id @default(cuid())
  propertyId           String
  leadId               String?
  developerId          String?
  status               DealTransactionStatus    @default(DRAFT)
  controlStatus        TransactionControlStatus @default(ON_HOLD)
  ownerHoldReason      String?
  ownerHoldAt          DateTime?
  ownerStoppedAt       DateTime?
  targetSellerPrice    Int?
  targetBuyerPrice     Int?
  targetAssignmentFee  Int?
  jurisdictionState    String
  transactionStructure String?
  counselApprovedAt    DateTime?
  complianceVerifiedAt DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  property             Property                 @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  lead                 Lead?                    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  developer            Developer?               @relation(fields: [developerId], references: [id], onDelete: SetNull)
  documents            TransactionDocument[]
  approvals            TransactionApproval[]
  auditEvents          TransactionAuditEvent[]
  agentTasks           AgentTask[]
  financialProjections FinancialProjection[]
  settlementReviews    SettlementReview[]
  sellerEngagements    SellerEngagement[]
  diligenceReviews     DiligenceReview[]
  outcomes             TransactionOutcome[]
  settlementArtifacts  SettlementArtifact[]
  acquisitionFunnel    AcquisitionFunnel?

  @@index([status, controlStatus])
  @@index([propertyId, createdAt])
  @@index([developerId])
}

model TransactionDocument {
  id              String                    @id @default(cuid())
  transactionId   String
  type            String
  title           String
  status          TransactionDocumentStatus @default(DRAFT)
  version         Int                       @default(1)
  storageKey      String?
  sourceUrl       String?
  contentHash     String?
  counselApproved Boolean                   @default(false)
  executedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  transaction     DealTransaction           @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([transactionId, type, version])
  @@index([transactionId, status])
}

model TransactionApproval {
  id            String                    @id @default(cuid())
  transactionId String
  type          TransactionApprovalType
  status        TransactionApprovalStatus @default(PENDING)
  requestedBy   String
  decidedBy     String?
  reason        String?
  requestedAt   DateTime                  @default(now())
  decidedAt     DateTime?
  expiresAt     DateTime?
  transaction   DealTransaction           @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([transactionId, type, status])
}

model TransactionAuditEvent {
  id            String          @id @default(cuid())
  transactionId String
  sequence      Int
  type          String
  actor         String
  summary       String
  details       Json?
  occurredAt    DateTime        @default(now())
  transaction   DealTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([transactionId, sequence])
  @@index([transactionId, occurredAt])
}

model Agent {
  id                       String            @id @default(cuid())
  name                     String
  role                     AgentRole         @unique
  status                   AgentStatus       @default(ACTIVE)
  autonomyMode             AgentAutonomyMode @default(LOCKED)
  description              String?
  autonomousOutbound       Boolean           @default(false)
  legalStandardsProvenAt   DateTime?
  ethicalStandardsProvenAt DateTime?
  complianceApprovedAt     DateTime?
  counselApprovedAt        DateTime?
  ownerAutonomyApprovedAt  DateTime?
  ownerAutonomyApprovedBy  String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  assignedTasks            AgentTask[]       @relation("AssignedAgentTasks")
  runs                     AgentRun[]
  eventsCreated            AgentEvent[]      @relation("AgentEventActor")
  handoffsSent             AgentEvent[]      @relation("AgentEventSource")
  handoffsReceived         AgentEvent[]      @relation("AgentEventTarget")
  capabilityGrants         AgentCapabilityGrant[]
  campaignAssignments     CampaignAgentAssignment[]

  @@index([status, autonomyMode])
}

model AgentTask {
  id                    String            @id @default(cuid())
  dedupeKey             String            @unique
  assignedAgentId       String
  taskType              String
  title                 String
  description           String?
  status                AgentTaskStatus   @default(QUEUED)
  priority              AgentTaskPriority @default(NORMAL)
  actionZone            AgentActionZone    @default(GREEN)
  costClass             AgentCostClass     @default(FREE)
  capability            String             @default("INTERNAL_RESEARCH")
  estimatedCostCents    BigInt             @default(0)
  expectedValueCents    BigInt?
  expectedBenefit       String?
  materialRisks         String[]            @default([])
  ownerApprovalRequired Boolean           @default(true)
  ownerApprovedAt       DateTime?
  ownerApprovedBy       String?
  approvalReason        String?
  evidenceCount         Int               @default(0)
  attemptCount          Int               @default(0)
  output                Json?
  transactionId         String?
  propertyId            String?
  developerId           String?
  dueAt                 DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  assignedAgent         Agent             @relation("AssignedAgentTasks", fields: [assignedAgentId], references: [id], onDelete: Restrict)
  transaction           DealTransaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  property              Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  developer             Developer?        @relation(fields: [developerId], references: [id], onDelete: SetNull)
  runs                  AgentRun[]
  events                AgentEvent[]

  @@index([assignedAgentId, status, priority])
  @@index([status, createdAt])
  @@index([transactionId, status])
  @@index([propertyId])
  @@index([developerId])
}

model AgentCapabilityGrant {
  id                    String              @id @default(cuid())
  agentId               String
  capability            String
  mode                  AgentCapabilityMode
  jurisdictionState     String?
  channel               String?
  maximumCostCents      BigInt              @default(0)
  minimumEvidenceCount  Int                 @default(1)
  minimumSuccessfulRuns Int                 @default(30)
  counselApprovedAt     DateTime?
  complianceApprovedAt  DateTime?
  ownerApprovedAt       DateTime?
  ownerApprovedBy       String?
  expiresAt             DateTime?
  suspendedAt           DateTime?
  suspensionReason      String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  agent                 Agent               @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@unique([agentId, capability, jurisdictionState, channel])
  @@index([mode, expiresAt, suspendedAt])
}

model AgentSchedulerCycle {
  id                    String               @id @default(cuid())
  trigger               AgentCycleTrigger
  status                AgentSchedulerStatus @default(RUNNING)
  deploymentId          String?
  tasksCreated          Int                  @default(0)
  tasksProcessed        Int                  @default(0)
  tasksCompleted        Int                  @default(0)
  tasksFailed           Int                  @default(0)
  tasksWaitingApproval  Int                  @default(0)
  propertiesConsidered  Int                  @default(0)
  developersConsidered  Int                  @default(0)
  transactionsConsidered Int                 @default(0)
  researchSummary       Json?
  errors                Json?
  startedAt             DateTime             @default(now())
  finishedAt            DateTime?

  @@index([status, startedAt])
  @@index([trigger, startedAt])
}

model AgentRun {
  id         String         @id @default(cuid())
  agentId    String
  taskId     String
  status     AgentRunStatus @default(RUNNING)
  summary    String?
  error      String?
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  agent      Agent          @relation(fields: [agentId], references: [id], onDelete: Restrict)
  task       AgentTask      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  events     AgentEvent[]

  @@index([taskId, startedAt])
  @@index([agentId, status, startedAt])
}

model AgentEvent {
  id            String         @id @default(cuid())
  taskId        String
  runId         String?
  actorAgentId  String?
  sourceAgentId String?
  targetAgentId String?
  type          AgentEventType
  summary       String
  details       Json?
