{
  "name": "personal-deal-scout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "npm run db:generate && node scripts/build.cjs",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js src prisma next.config.ts eslint.config.mjs",
    "test": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:browser": "node --env-file-if-exists=.env --test tests/operational-report.browser.mjs",
    "db:generate": "node ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/prisma-direct.cjs migrate dev",
    "db:migrate:deploy": "node --env-file-if-exists=.env scripts/prisma-direct.cjs migrate deploy",
    "db:status": "node --env-file-if-exists=.env scripts/prisma-direct.cjs migrate status",
    "db:seed": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:resolve-public-records": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs scripts/resolve-public-record-no-results.ts",
    "dev:novu": "npx novu dev -p 4005 --no-studio --route /api/novu --run \"node ./node_modules/next/dist/bin/next dev\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.66",
    "@novu/framework": "^2.13.2",
    "@prisma/client": "^6.19.3",
    "@types/geojson": "^7946.0.16",
    "@vercel/analytics": "^2.0.1",
    "@vercel/queue": "^0.5.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.99",
    "geojson": "^0.5.0",
    "leaflet": "^1.9.4",
    "next": "^16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.66.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "playwright": "^1.63.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true,
    "unrs-resolver": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
