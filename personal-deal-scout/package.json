{
  "name": "personal-deal-scout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "npm run db:generate && node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js src prisma next.config.ts eslint.config.mjs",
    "test": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "db:generate": "node ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/prisma-direct.cjs migrate dev",
    "db:migrate:deploy": "node --env-file-if-exists=.env scripts/prisma-direct.cjs migrate deploy",
    "db:status": "node --env-file-if-exists=.env scripts/prisma-direct.cjs migrate status",
    "db:seed": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
