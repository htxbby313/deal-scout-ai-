# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://deal_scout:change-me@localhost:5432/deal_scout?schema=public"
# Optional explicit non-pooled migration URL. Neon URLs are derived by removing -pooler when omitted.
DIRECT_URL=""
# Prisma pool limits are applied when DATABASE_URL does not already specify them.
DATABASE_POOL_MAX="5"
DATABASE_POOL_TIMEOUT_SECONDS="10"
DATABASE_CONNECT_TIMEOUT_SECONDS="10"

# One private owner account. Use a long, unique password and 32+ byte secret.
OWNER_USERNAME="owner"
OWNER_PASSWORD="change-me"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Protects the automatic property-research cron route. Set the same secret in Vercel.
CRON_SECRET="replace-with-a-long-random-secret"

# Safe defaults. ACTIVE alone never enables a provider.
SYSTEM_MODE="RESEARCH"
SMS_PROVIDER_ENABLED="false"
EMAIL_PROVIDER_ENABLED="false"
VOICE_PROVIDER_ENABLED="false"

# Leave provider credentials unset until a provider is selected and verified.
SMS_PROVIDER_API_KEY=""
EMAIL_PROVIDER_API_KEY=""
VOICE_PROVIDER_API_KEY=""

# Optional hosted reasoning for internal, non-authoritative evidence analysis.
NVIDIA_API_KEY=""
NVIDIA_REASONING_MODEL="nvidia/nemotron-3-super-120b-a12b"

# Optional licensed property-record enrichment. Keep both values server-only.
ENFORMION_ACCESS_PROFILE_NAME=""
ENFORMION_ACCESS_PROFILE_PASSWORD=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_ENABLED="false"
GOOGLE_MAPS_SERVER_API_KEY=""
GOOGLE_MAPS_SERVER_API_RESTRICTIONS_VERIFIED="false"
DEAL_SCOUT_CANONICAL_ORIGIN="https://deal-scout-ai-tltx.vercel.app"
GOOGLE_MAPS_ENABLED="false"
# Set these only after verifying each control in Google Cloud and Vercel.
GOOGLE_MAPS_ORIGIN_RESTRICTIONS_VERIFIED="false"
GOOGLE_MAPS_API_RESTRICTIONS_VERIFIED="false"
GOOGLE_MAPS_QUOTAS_VERIFIED="false"
GOOGLE_MAPS_BILLING_ALERTS_VERIFIED="false"
GOOGLE_MAPS_ATTRIBUTION_VERIFIED="false"
GOOGLE_MAPS_TELEMETRY_VERIFIED="false"
GOOGLE_MAPS_KILL_SWITCH_VERIFIED="false"
GOOGLE_MAPS_OWNER_APPROVED_AT=""
ENFORMION_MONTHLY_MATCH_LIMIT="3000"

# Optional backend-only fallback for scraping saved property source pages.
# Firecrawl evidence always requires corroboration or owner review.
FIRECRAWL_ENABLED="false"
FIRECRAWL_API_KEY=""
FIRECRAWL_MAX_REQUESTS_PER_RUN="2"

# Required before accepting provider webhooks.
WEBHOOK_SECRET=""
